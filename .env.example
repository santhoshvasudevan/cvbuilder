# Copy this file to .env and fill in real values. Never commit .env.
# cp .env.example .env

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (matches docker-compose.yml) ---
POSTGRES_DB=cvbuilder
POSTGRES_USER=cvbuilder
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- LLM provider credentials (not used until M2 — llm_provider does not exist yet) ---
# The llm_provider registry (LLMProvider rows, Milestone M2) will store only the *name* of the
# environment variable holding each credential, never the credential value itself
# (requirements.md LLM-012). Populate whichever providers you actually use once M2 lands.
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
