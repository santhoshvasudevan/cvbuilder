# Copy this file to .env and fill in real values. Never commit .env.
# cp .env.example .env

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (matches docker-compose.yml) ---
POSTGRES_DB=cvbuilder
POSTGRES_USER=cvbuilder
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- LLM provider credentials ---
# The llm_provider registry (LLMProvider rows, Milestone M2) stores only the *name* of the
# environment variable holding each credential, never the credential value itself
# (requirements.md Section 9.2 / NFR-003). Populate whichever providers you actually use.
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=
# Used by every OpenRouter-routed model, including the Free Models Router ('openrouter/free',
# D-038) -- one credential per OpenRouter account, not one per routed model.
OPENROUTER_API_KEY=

# Optional OpenRouter attribution headers (openrouter.ai/docs) -- identify the calling app to
# OpenRouter, never a credential. Leave blank to omit them from requests entirely; the adapter
# never invents a placeholder value when they are absent.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
